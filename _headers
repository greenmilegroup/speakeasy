# Cloudflare Pages cache rules.
#
# The site is a set of ES modules that import each other, so a query-string
# cache buster on the <script> tag would not reach js/i18n.js or js/events-data.js.
# The fix is revalidation: code and data carry no-cache, which does not mean
# "do not cache" — the browser keeps its copy and asks with an ETag, so an
# unchanged file costs a 304 and a changed one is picked up immediately.
#
# This exists because a stale js/events.js was left running against fresh HTML
# after an element it referenced was deleted. It threw, and took the whole
# events calendar down with it while the page looked fine above the fold.

/*.html
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

/assets/data/*
  Cache-Control: no-cache

# Media is content-addressed by name in practice: a changed photograph or clip
# gets a new filename. Long cache, and it never goes stale in a way that breaks.
/assets/img/*
  Cache-Control: public, max-age=31536000

/assets/video/*
  Cache-Control: public, max-age=31536000

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
