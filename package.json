{
  "name": "speakeasy-3d-venue-tour",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Walkable 3D virtual tour of Speakeasy Tapas Lounge (Ottawa) for private-event bookings",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "screenshot": "node scripts/screenshot.mjs",
    "build:single": "tsc --noEmit && SINGLE_FILE=1 vite build"
  },
  "dependencies": {
    "@fontsource/limelight": "^5.2.7",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
